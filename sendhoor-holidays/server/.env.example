# Copy this file to .env and fill in the values. Never commit .env.

PORT=4100

# Where booking and enquiry emails go, and the address they are sent from.
OWNER_EMAIL=sendhoorholidays2004@gmail.com

# Gmail SMTP. Use a Gmail app password (Google Account > Security > App passwords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sendhoorholidays2004@gmail.com
SMTP_PASS=

# Owner sign-in for updating packages (/admin on the website). Use a long, unique password.
ADMIN_PASSWORD=

# Owner mobile numbers for SMS and WhatsApp, comma separated, in international format.
OWNER_PHONES=+918754610755,+917397394833

# Twilio. SMS needs a Twilio phone number. WhatsApp needs a Twilio WhatsApp sender (or the sandbox number while testing).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Optional persistent directories for admin data and uploaded images. On Render,
# set both to subdirectories of the mounted disk. Locally they default to server/data.
# DATA_DIR=/var/data
# UPLOADS_DIR=/var/data/uploads
